---
import Bar from '../Bar/Bar.astro'
import CircleLauncher from '../CircleLauncher/CircleLauncher.astro'
import './Desktop.css'

/* Programs' CSS */
import '../../programs/CatViewer/CatViewer.css';
import '../../programs/Counter/Counter.css';
---

<img id="wallpaper" src="/mousos/assets/wallpapers/wallpaper.webp">
<div id="controls">
    <p>Controls</p>
    <p>App Launcher: CTRL + RIGHT CLICK</p>
    <p>Drag Window: ALT + LEFT CLICK (hold and move)</p>
    <p>Resize Window: ALT + RIGHT CLICK (hold and move)</p>
</div>
<div id="desktop">
    <CircleLauncher />
    <Bar />

    <div id="programs">
        
    </div>
</div>
