---
import './CircleLauncher.css';
---

<div id="circle-launcher-wrapper">
    <div id="circle-launcher">
        <input id="circle-launcher-search" type="text">
        <button id="circle-launcher-close"><img src="/mousos/assets/icons/close.svg"></button>
        <nav id="circle-launcher-items">
        </nav>
    </div>
</div>

<script>
    import { programs } from "../../scripts/programHandler";
    import { run } from "../../scripts/programHandler";

    enum ItemType {
        APPLICATION,
        ACTION
    }

    let active = false;

    class Item {
        name: string;
        icon: string;
        exec: string;
        type: ItemType;
        invert: boolean;

        constructor(name: string, icon: string, exec: string, type: ItemType = ItemType.APPLICATION, invert: boolean = true) {
            this.name = name;
            this.icon = icon;
            this.type = type;
            this.exec = exec;
            this.invert = invert;
        }

        getHTML() {
            const button = document.createElement("button");
            button.classList.add("circle-launcher-entry");

            const span = document.createElement("span");
            span.innerText = this.name;
            button.appendChild(span);

            const img = document.createElement("img");
            img.src = `/assets/icons/${this.icon}`;
            if (this.icon.endsWith(".svg") && this.invert) {
                img.style.filter = "invert(0.8)";
            }
            button.append(img);

            button.setAttribute("data-exec", this.exec);

            return button;
        }
    }

    const navItems: Item[] = [];
    programs.forEach(program => {
        if (program.prettyName != undefined && program.icon != undefined, program.name != undefined) {
            navItems.push(new Item(program.prettyName, program.icon, program.name));
        }
    });

    const actionItems: Item[] = [];
    // actionItems.push(new Item("Minimize", "bundle.png", "minimize", ItemType.ACTION, false));
    actionItems.push(new Item("Close", "mallet.svg", "close", ItemType.ACTION, false),);

    const wrapper = document.getElementById("circle-launcher-wrapper");
    const circleLauncher = document.getElementById("circle-launcher");
    const closeButton = document.getElementById("circle-launcher-close");
    const searchBar = document.getElementById("circle-launcher-search") as HTMLInputElement;
    const itemsEl = circleLauncher?.getElementsByTagName("nav")[0];

    function close() {
        active = false;

        if (wrapper != null) {
            wrapper.style.display = "none";
            wrapper.style.opacity = "0";
        }

        if (itemsEl != null) {
            itemsEl.innerHTML = "";
        }
    }

    function open(posX: number, posY: number) {
        searchBar.value = "";

        if (wrapper != null) {
            wrapper.style.display = "block";
            wrapper.style.opacity = "1";

            wrapper.style.left = posX.toString() + "px";
            wrapper.style.top = posY.toString() + "px";
        }

        update();
    }

    function update(items: Item[] = [...navItems]) {
        if (itemsEl != null) {
            itemsEl.innerHTML = "";
        }

        if (items != null) {
            const radius = 160;
            const radian = Math.PI / 180;
            const gap = 36;

            items = items.slice(0, 6);

            items.forEach(item => {
                itemsEl?.appendChild(item.getHTML());
            });

            for (let i = 0; i < (6 - items.length + 1); i++) {
                const seperator = document.createElement("div");
                seperator.classList.add("seperator");
                itemsEl?.appendChild(seperator);
            }
            
            actionItems.forEach(item => {
                itemsEl?.appendChild(item.getHTML());
            })

            if (itemsEl != null) {
                for (let i = 0; i < itemsEl.children.length; i++) {
                    const item = itemsEl.children[i] as HTMLElement;
                    if (item.classList.contains("seperator")) continue;

                    const exec = item.getAttribute("data-exec");

                    item.addEventListener("click", () => {
                        if (exec != null) {
                            const top = parseInt(wrapper?.style.top as string);
                            const left = parseInt(wrapper?.style.left as string);

                            run(exec, top, left);
                        }

                        close();
                    });

                    const top = (radius * Math.cos(radian * (i * gap)) * -1);
                    const left = (radius * Math.sin(radian * (i * gap)));

                    item.style.top = top.toFixed(4) + "px";
                    item.style.left = left.toFixed(4) + "px";

                    const name = item.getElementsByTagName("span")[0] as HTMLElement;
                    const nameDistance = 20;
                    if (i * gap == 0) {
                        name.style.top = `-${nameDistance}px`;
                        name.style.textAlign = "center";
                    } else if (i * gap == 180) {
                        name.style.top = (item.clientHeight + nameDistance) + "px";
                        name.style.textAlign = "center";
                    } else if (i * gap < 180) {
                        name.style.left = (item.clientWidth + nameDistance) + "px";
                        name.style.transform = "translateY(-50%)";
                        name.style.textAlign = "left";
                    } else if (i * gap > 180) {
                        name.style.left = `-${item.clientWidth + nameDistance}px`;
                        name.style.transform = "translateY(-50%)";
                        name.style.textAlign = "left";
                    }
                
                    if (!active) {
                        setTimeout(() => {
                            item.style.opacity = "1";
                        }, 25 * i);
                    } else {
                        item.style.opacity = "1";
                    }
                }

                active = true;

                searchBar.focus();
            }

            // Height of launcher
            if (circleLauncher != null && closeButton != null && (itemsEl as HTMLElement).children.length > 0) {
                const size = (radius + (itemsEl as HTMLElement).children[0].clientHeight / 2) * 2;
                circleLauncher.style.height = `${size}px`
                circleLauncher.style.width = `${size}px`;
            }
        }
    }

    document.addEventListener("contextmenu", (e) => {
        e.preventDefault();

        if (e.ctrlKey) {
            open(e.clientX, e.clientY);
        }
    });

    closeButton?.addEventListener("click", () => {
        close();
    });

    searchBar?.addEventListener("input", () => {
        if (searchBar.value == "") {
            update()
        } else {
            update([...navItems].filter((e) => {
                if (e == undefined) return false;
                e.name.toLowerCase().includes(searchBar.value.toLowerCase());
            }));
        }
    });
</script>
